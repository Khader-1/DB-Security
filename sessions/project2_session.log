col username for a12
col action_name for a10
col obj_name for a10
col sql_text for a50
select username, action_name, obj_name, sql_text from dba_audit_trail where obj_name in ('EMPLOYEES','SALARIES') order by timestamp;
select username, action_name, returncode from dba_audit_trail where returncode <> 0 order by timestamp;
select audit_id, action, action_user, emp_id, old_salary, new_salary from secaud.salary_audit_log order by audit_id;
delete from secaud.salary_audit_log;
update secaud.salary_audit_log set new_salary = 0;
