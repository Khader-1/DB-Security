docker exec -it oracle-11g bash -lc 'sqlplus "sys/oracle@localhost:1521/XE as sysdba"'
show parameter audit_trail
show parameter audit_sys_operations
show parameter audit_file_dest
audit select, insert, update, delete on khader.employees by access;
audit grant, revoke by access;
audit system grant by access;
audit session whenever not successful;
audit select, insert, update, delete on khader.salaries by access;
select object_name, sel, ins, upd, del from dba_obj_audit_opts where owner = 'KHADER';
create user secaud identified by "Secaud#2026" default tablespace users quota unlimited on users;
create table secaud.salary_audit_log (audit_id number, action varchar2(10), action_user varchar2(30), action_time timestamp, emp_id number(6), old_salary number(10,2), new_salary number(10,2));
create sequence secaud.seq_salary_audit start with 1 increment by 1 nocache;
desc secaud.salary_audit_log
grant insert on secaud.salary_audit_log to khader;
grant select on secaud.seq_salary_audit to khader;
create or replace trigger khader.trg_salaries_audit after insert or update or delete on khader.salaries for each row declare v_action varchar2(10); begin if inserting then v_action := 'INSERT'; elsif updating then v_action := 'UPDATE'; else v_action := 'DELETE'; end if; insert into secaud.salary_audit_log values (secaud.seq_salary_audit.nextval, v_action, user, systimestamp, nvl(:new.emp_id, :old.emp_id), :old.base_salary, :new.base_salary); end;
/
audit all on sys.aud$ by access;
create or replace trigger secaud.trg_protect_salary_log before update or delete on secaud.salary_audit_log begin raise_application_error(-20999, 'Audit records are append-only and cannot be modified or deleted.'); end;
/
connect khader_pwd/"Khader#120191118"@localhost:1521/XE
